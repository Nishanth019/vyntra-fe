# Copy to .env and fill in. Values prefixed EXPO_PUBLIC_ are bundled into the app, so never put secrets here.

# Backend API base URL.
EXPO_PUBLIC_API_URL=https://vyntra-lime.vercel.app/api/v1

# Support channels shown on the Contact Us screen. Leave a value empty to hide that option.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_PHONE=
# Full number with country code, digits only, e.g. 919876543210
EXPO_PUBLIC_SUPPORT_WHATSAPP=
